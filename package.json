{
  "name": "offgrid",
  "private": true,
  "version": "1.0.0",
  "description": "OffGrid: plan trails online, download them for fully offline navigation, and confirm your position in the field with photo-based landmark matching.",
  "workspaces": [
    "packages/*",
    "backend",
    "mobile"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:backend": "npm run test --workspace backend",
    "test:mobile": "npm run test --workspace mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck && npm test",
    "dev:backend": "npm run dev --workspace backend",
    "changes": "node scripts/changes.mjs diff",
    "release:snapshot": "node scripts/changes.mjs snapshot",
    "demo": "node scripts/demo.mjs"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  }
}
