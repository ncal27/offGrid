# Copy to .env (never commit .env) and fill in.
PORT=4000
# Shared secret for POST /contributions/:id/promote and /:id/reject.
# Must be at least 32 characters, or the review endpoints stay disabled.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OFFGRID_REVIEWER_TOKEN=
